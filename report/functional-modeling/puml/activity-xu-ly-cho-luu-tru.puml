@startuml
title Sơ đồ hoạt động - Xử lý học sinh chờ lưu trữ
skinparam shadowing false

|Giáo viên|
start
:Mở danh sách học sinh chờ lưu trữ;
:Chọn học sinh cần xử lý;

|Hệ thống TMS|
:Kiểm tra trạng thái học sinh;

if (Học sinh đang chờ lưu trữ?) then (Có)
  :Đối soát số dư và khoản phí còn liên quan;
  if (Tài chính đã xử lý xong?) then (Có)
    :Chuyển học sinh sang trạng thái đã lưu trữ;
    :Cập nhật danh sách học sinh;
    :Thông báo lưu trữ thành công;
  else (Chưa)
    :Hiển thị số tiền hoặc khoản phí cần xử lý tiếp;
    :Giữ học sinh ở trạng thái chờ lưu trữ;
  endif
else (Không)
  :Thông báo học sinh không thuộc diện xử lý;
endif

stop
@enduml
