@startuml
title Sơ đồ hoạt động - Quản lý học sinh
skinparam shadowing false

|Giáo viên|
start
:Mở chức năng quản lý học sinh;
:Chọn thao tác cần thực hiện;

if (Thao tác?) then (Xem danh sách)
  |Hệ thống TMS|
  :Áp dụng bộ lọc tìm kiếm;
  :Hiển thị danh sách học sinh;
elseif (Thêm học sinh)
  |Giáo viên|
  :Nhập thông tin học sinh;
  :Chọn lớp nếu cần;
  |Hệ thống TMS|
  :Kiểm tra thông tin bắt buộc;
  if (Thông tin hợp lệ?) then (Có)
    :Ghi nhận hồ sơ học sinh;
    if (Có chọn lớp?) then (Có)
      :Gắn học sinh với lớp được chọn;
    endif
    :Hiển thị hồ sơ mới;
  else (Không)
    :Hiển thị lỗi cần chỉnh sửa;
  endif
else (Cập nhật học sinh)
  |Giáo viên|
  :Chỉnh sửa thông tin học sinh;
  |Hệ thống TMS|
  :Kiểm tra quyền quản lý và dữ liệu nhập;
  if (Có thể cập nhật?) then (Có)
    :Ghi nhận thay đổi;
    :Hiển thị hồ sơ đã cập nhật;
  else (Không)
    :Thông báo lý do không thể cập nhật;
  endif
endif

stop
@enduml
