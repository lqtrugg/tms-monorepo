@startuml
title Sơ đồ tuần tự - Đăng nhập hệ thống
skinparam shadowing false
skinparam maxMessageSize 90

actor "Giáo viên /\nQuản trị viên" as User
boundary "Giao diện web" as Web
control "API client" as ApiClient
control "Route" as Route
control "Security" as Security
control "Controller" as Controller
control "Account" as Account
control "AccountReader" as AccountReader
database "Azure Database Server\nCSDL TMS" as DB

User -> Web : Nhập thông tin đăng nhập
Web -> ApiClient : Gửi yêu cầu đăng nhập
ApiClient -> Route : Chuyển yêu cầu đến backend
Route -> Security : Kiểm tra yêu cầu công khai
Security --> Route : Cho phép xử lý
Route -> Controller : Chuyển dữ liệu đăng nhập
Controller -> Account : Kiểm tra tài khoản
Account -> AccountReader : Đọc thông tin tài khoản
AccountReader -> DB : Truy vấn dữ liệu tài khoản
DB --> AccountReader : Tài khoản và trạng thái
AccountReader --> Account : Kết quả đọc dữ liệu

alt Tài khoản hợp lệ
  Account --> Controller : Kết quả đăng nhập thành công
  Controller --> Route : Hồ sơ người dùng và quyền sử dụng
  Route --> ApiClient : Trả kết quả thành công
  ApiClient --> Web : Cập nhật phiên làm việc
  Web --> User : Đi vào màn hình phù hợp
else Tài khoản không hợp lệ
  Account --> Controller : Lý do từ chối
  Controller --> Route : Kết quả lỗi
  Route --> ApiClient : Trả thông báo lỗi
  ApiClient --> Web : Hiển thị lỗi
  Web --> User : Yêu cầu kiểm tra thông tin
end
@enduml
