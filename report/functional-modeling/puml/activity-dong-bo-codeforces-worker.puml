@startuml
title Sơ đồ hoạt động - Worker đồng bộ thông tin từ Codeforces
skinparam shadowing false

start
:Đến chu kỳ đồng bộ Codeforces;
:Lấy danh sách giáo viên cần kiểm tra;

while (Còn giáo viên?) is (Có)
  :Kiểm tra cấu hình Codeforces của giáo viên;

  if (Cấu hình đầy đủ?) then (Có)
    :Lấy danh sách Gym giáo viên sở hữu từ Codeforces;

    if (Lấy danh sách Gym thành công?) then (Có)
      :Cập nhật danh mục Gym trong TMS;
      :Xác định các Gym đã gắn với lớp;

      while (Còn Gym đã gắn lớp?) is (Có)
        :Kiểm tra Gym có thuộc giáo viên hay không;

        if (Gym hợp lệ?) then (Có)
          :Lấy bảng kết quả Gym từ Codeforces;

          if (Có bảng kết quả?) then (Có)
            fork
              :Cập nhật thông tin Gym và danh sách bài;
            fork again
              :Xác định học sinh đang học có Codeforces handle;
            end fork
            :Ghép kết quả Codeforces với học sinh;
            :Cập nhật bảng kết quả Gym trong TMS;
          else (Không)
            :Bỏ qua Gym hiện tại;
          endif
        else (Không)
          :Bỏ qua Gym hiện tại;
        endif
      endwhile (Không)
    else (Không)
      :Ghi nhận lần đồng bộ thất bại;
    endif
  else (Không)
    :Bỏ qua giáo viên hiện tại;
  endif
endwhile (Không)

:Ghi nhận kết quả lượt đồng bộ;
:Chờ chu kỳ tiếp theo;
stop
@enduml
