@startuml
title Sơ đồ hoạt động - Quản lý buổi học
skinparam shadowing false

|Giáo viên|
start
:Mở chức năng quản lý buổi học;
:Chọn thao tác cần thực hiện;

if (Thao tác?) then (Xem danh sách)
  |Hệ thống TMS|
  :Lọc buổi học theo lớp và thời gian;
  :Hiển thị danh sách buổi học;
elseif (Tạo buổi học)
  |Giáo viên|
  :Nhập lớp và thời gian buổi học;
  |Hệ thống TMS|
  :Kiểm tra lớp còn hoạt động;
  :Kiểm tra thời gian hợp lệ;
  :Kiểm tra trùng hoặc chồng lịch;
  if (Có thể tạo?) then (Có)
    :Ghi nhận buổi học mới;
    :Hiển thị buổi học trong danh sách;
  else (Không)
    :Thông báo lý do không thể tạo;
  endif
else (Hủy buổi học)
  |Giáo viên|
  :Chọn buổi học cần hủy;
  |Hệ thống TMS|
  :Kiểm tra buổi học có thể hủy;
  if (Có thể hủy?) then (Có)
    :Chuyển buổi học sang trạng thái đã hủy;
    :Cập nhật ảnh hưởng liên quan;
    :Hiển thị trạng thái mới;
  else (Không)
    :Thông báo lý do không thể hủy;
  endif
endif

stop
@enduml
