@startuml
title Sơ đồ tuần tự - Worker đồng bộ thông tin từ Codeforces
skinparam shadowing false
skinparam maxMessageSize 100

control "Background Sync Worker" as Worker
control "AccountWriter" as AccountWriter
control "Codeforces Client" as CodeforcesClient
participant "Codeforces" as Codeforces
control "TypeOrmGymReader" as GymReader
control "TypeOrmGymWriter" as GymWriter
control "TypeOrmStudentReader" as StudentReader
database "Azure Database Server\nCSDL TMS" as DB

Worker -> Worker : Đến lượt chạy của SyncLoop
Worker -> AccountWriter : Lấy danh sách giáo viên cần đồng bộ Codeforces
AccountWriter -> DB : Đọc danh sách giáo viên
DB --> AccountWriter : Danh sách giáo viên
AccountWriter --> Worker : Danh sách giáo viên cần xét

loop Với từng giáo viên
  Worker -> AccountWriter : Lấy cấu hình Codeforces của giáo viên
  AccountWriter -> DB : Đọc TeacherCodeforcesCredential
  DB --> AccountWriter : Định danh và khoá truy cập Codeforces
  AccountWriter --> Worker : Cấu hình Codeforces

  alt Thiếu cấu hình Codeforces
    Worker -> Worker : Bỏ qua teacher hiện tại
  else Cấu hình đầy đủ
    Worker -> CodeforcesClient : Lấy danh sách Gym nhìn thấy
    CodeforcesClient -> Codeforces : Yêu cầu danh sách Gym từ Codeforces
    Codeforces --> CodeforcesClient : Danh sách Gym
    CodeforcesClient --> Worker : Gym do handle của giáo viên chuẩn bị

    alt Codeforces lỗi
      Worker -> Worker : Bỏ qua teacher hiện tại
    else Lấy Gym thành công
      Worker -> GymWriter : Đồng bộ catalog Gym của giáo viên
      GymWriter -> DB : Upsert Gym catalog và xoá catalog stale
      DB --> GymWriter : Kết quả lưu catalog
      GymWriter --> Worker : Số Gym catalog đã đồng bộ

      Worker -> GymReader : Lấy danh sách Gym đã gắn với lớp
      GymReader -> DB : Đọc Gym đã gắn lớp
      DB --> GymReader : Danh sách Gym của lớp
      GymReader --> Worker : Danh sách Gym đã gắn lớp

      loop Với từng Gym đã gắn lớp
        Worker -> Worker : Xác định mã Gym Codeforces

        alt Gym không thuộc giáo viên hoặc thiếu mã Gym
          Worker -> Worker : Bỏ qua Gym hiện tại
        else Gym hợp lệ
          opt Chưa có snapshot trong cache
            Worker -> CodeforcesClient : Lấy bảng kết quả Gym
            CodeforcesClient -> Codeforces : Yêu cầu standing của Gym
            Codeforces --> CodeforcesClient : Problems và rows
            CodeforcesClient --> Worker : CodeforcesGymSnapshot
          end

          alt Không lấy được standing
            Worker -> Worker : Bỏ qua Gym hiện tại
          else Có standing
            Worker -> GymWriter : Đồng bộ bảng kết quả Gym vào TMS
            GymWriter -> DB : Cập nhật Gym và GymProblem
            GymWriter -> StudentReader : Lấy học sinh đang học có Codeforces handle
            StudentReader -> DB : Đọc học sinh đang học có Codeforces handle
            DB --> StudentReader : Danh sách học sinh
            StudentReader --> GymWriter : Học sinh để ghép standing
            GymWriter -> DB : Cập nhật GymStanding
            DB --> GymWriter : Đã lưu projection
            GymWriter --> Worker : Đồng bộ standing thành công
          end
        end
      end
    end
  end
end

Worker -> Worker : Ghi log tổng kết pass
Worker -> Worker : Chờ interval kế tiếp
@enduml
