@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam wrapWidth 140

actor "Frontend" as Frontend

package "Route groups dưới /api" as Routes {
  component "/register, /login, /me" as AccountRoutes
  component "/students" as StudentRoutes
  component "/classes" as ClassRoutes
  component "/sessions, /attendance" as SessionRoutes
  component "/finance" as FinanceRoutes
  component "/reporting" as ReportRoutes
  component "/admin" as AdminRoutes
  component "/discord" as DiscordRoutes
}

package "Controller" as Controllers {
  component "Account Controller" as AccountController
  component "Student Controller" as StudentController
  component "Classroom Controller" as ClassroomController
  component "Finance Controller" as FinanceController
  component "System Controller" as SystemController
}

package "Module nghiệp vụ" as Modules {
  component "Account" as Account
  component "Student" as Student
  component "Classroom" as Classroom
  component "Finance" as Finance
  component "System" as System
}

Frontend --> Routes : "HTTP request"
AccountRoutes --> AccountController
StudentRoutes --> StudentController
ClassRoutes --> ClassroomController
SessionRoutes --> ClassroomController
FinanceRoutes --> FinanceController
ReportRoutes --> StudentController
ReportRoutes --> FinanceController
AdminRoutes --> SystemController
DiscordRoutes --> AccountController
DiscordRoutes --> StudentController
DiscordRoutes --> ClassroomController

AccountController --> Account
StudentController --> Student
ClassroomController --> Classroom
FinanceController --> Finance
SystemController --> System

@enduml
