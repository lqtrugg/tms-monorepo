@startuml
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle

rectangle "Presentation layer" as Presentation {
  component "Giao diện web" as Web
  component "API endpoint" as Endpoint
}

rectangle "Business layer" as Business {
  component "Use case" as UseCase
  component "Domain rule" as Rule
}

rectangle "Data layer" as Data {
  component "Persistence" as Persistence
  database "Azure Database Server\nCSDL TMS" as DB
}

Web --> Endpoint
Endpoint --> UseCase
UseCase --> Rule
UseCase --> Persistence
Persistence --> DB

@enduml
