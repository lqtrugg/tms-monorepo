@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle

package "Backend TMS" {
  component "Account" as Account
  component "Student" as Student
  component "Classroom" as Classroom
  component "Finance" as Finance
  component "System" as System
  component "Security" as Security
}

Security ..> Account
Security ..> Student
Security ..> Classroom
Security ..> Finance
Security ..> System

Classroom ..> Student : "tham chiếu học sinh / ghi danh"
Classroom ..> Finance : "phát sinh khoản phí"
System ..> Account : "quản trị tài khoản"

note bottom
Các module nằm trong cùng backend,
không gọi nhau bằng HTTP nội bộ.
end note

@enduml
