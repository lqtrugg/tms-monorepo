@startuml
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle

actor "Người dùng" as User
component "Đăng nhập" as Login
component "Token truy cập" as Token
component "Kiểm tra vai trò" as Role
component "Kiểm tra phạm vi sở hữu" as Ownership
component "Chức năng nghiệp vụ" as Feature

User --> Login
Login --> Token
Token --> Role
Role --> Ownership
Ownership --> Feature

@enduml
