@startuml
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 140

package "Azure Database Server" as AzureDB {
  database "Dữ liệu nghiệp vụ TMS\n(source of truth)" as BusinessData
  database "Cấu hình tích hợp\nvà credential" as IntegrationConfig
  database "Dữ liệu đồng bộ\nđể hiển thị" as SyncedData
}

cloud "Discord" as Discord
cloud "Codeforces" as Codeforces
component "Backend TMS" as Backend

Backend --> BusinessData : "đọc / ghi nghiệp vụ"
Backend --> IntegrationConfig : "lưu cấu hình, token,\nliên kết lớp"
Backend --> SyncedData : "lưu dữ liệu đã đồng bộ"

Discord --> Backend : "OAuth, guild,\nchannel, message"
Codeforces --> Backend : "Gym, problem,\nstanding"
Backend --> Discord : "gọi khi cần tích hợp"
Backend --> Codeforces : "gọi khi cần đồng bộ"

note right of BusinessData
Dữ liệu nghiệp vụ nội bộ
không phụ thuộc trực tiếp vào
thời điểm Discord/Codeforces phản hồi.
end note

@enduml
