@startuml
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle

rectangle "Client" as Client {
  component "Giao diện web" as Web
}

rectangle "Server" as Server {
  component "Backend TMS\nModular monolith" as Backend
}

database "Azure Database Server" as DB

cloud "Hệ thống ngoài" as External {
  component "Discord" as Discord
  component "Codeforces" as Codeforces
}

Web --> Backend : "HTTP request"
Backend --> DB : "đọc / ghi dữ liệu"
Backend --> Discord : "tích hợp"
Backend --> Codeforces : "đồng bộ dữ liệu"

note bottom of Backend
Backend là một ứng dụng triển khai,
nhưng được chia module ở bên trong.
end note

@enduml
