@startuml
left to right direction
skinparam rectangle {
  RoundCorner 8
}
actor "Giáo viên, Discord" as Actor
rectangle "Cập nhật điểm danh" as Process
database "Buổi học, học sinh, ghi danh, điểm danh, học phí" as Store
Actor --> Process : Trạng thái điểm danh\nTrạng thái voice Discord
Process --> Store : Dữ liệu cần lưu/tra cứu
Store --> Process : Dữ liệu nghiệp vụ
Process --> Actor : Danh sách điểm danh\nKhoản học phí phát sinh
@enduml
