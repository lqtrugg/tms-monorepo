@startuml
left to right direction
skinparam rectangle {
  RoundCorner 8
}
actor "Giáo viên, Codeforces" as Actor
rectangle "Gắn Gym Codeforces" as Process
database "Gym Codeforces, lớp học" as Store
Actor --> Process : Gym được chọn\nLớp học
Process --> Store : Dữ liệu cần lưu/tra cứu
Store --> Process : Dữ liệu nghiệp vụ
Process --> Actor : Gym đã gắn với lớp
@enduml
